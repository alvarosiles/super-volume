{
  "manifest_version": 3,
  "default_locale": "es",
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "2.0.0",
  "description": "__MSG_extDescription__",
  "author": "alvarosiles",
  "homepage_url": "https://github.com/alvarosiles/super-volume",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Super Volume",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],

  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],

  "minimum_chrome_version": "102"
}
